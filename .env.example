# Copy to .env and adjust as needed — docker-compose.yml reads this automatically.
# Same override convention as setup_and_run.sh: change ports here, not in code.

BACKEND_PORT=9050
NODE_PORT=5050

# Set a real value in any shared/deployed environment — the default in docker-compose.yml
# (super-secret-dev-key, matching config.py's own fallback) signs session cookies, so leaving
# it unset there means every login is only as secure as that well-known string.
SECRET_KEY=
